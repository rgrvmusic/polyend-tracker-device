 void PtfxLoader::syncInstructionCache([[maybe_unused]] void* addr, [[maybe_unused]] uint32_t size)
 {
+#ifdef TRACKER_HOST
+    // The Linux kernel owns the caches; make the freshly written Thumb code
+    // visible to the instruction fetcher of this core.
+    __builtin___clear_cache(reinterpret_cast<char*>(addr),
+                            reinterpret_cast<char*>(addr) + size);
+    return;
+#endif
